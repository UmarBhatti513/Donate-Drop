<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6">

    <!-- Top toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:title="Admin"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- White rounded content card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/contentCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="24dp"
        app:cardUseCompatPadding="true"
        app:cardElevation="6dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@android:color/white">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="34dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Profile block (name & role) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingBottom="0dp">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@drawable/bg_profile_circle"
                        android:scaleType="centerCrop"
                        android:layout_marginTop="0dp"
                        android:background="@drawable/circle_white_with_shadow"
                        android:padding="4dp" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Umar Bhatti"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="0dp"
                        android:textColor="@color/textPrimary" />

                    <TextView
                        android:id="@+id/tvRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin · DonateDrop"
                        android:textSize="12sp"
                        android:layout_marginTop="0dp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>

                <!-- Section: General -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="General"
                    android:textStyle="bold"
                    android:textColor="@color/textSecondary"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_edit_profile"
                    android:tag="edit" />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_email"
                    android:tag="email"
                    />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_change_password"
                    android:tag="password"
                    />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_notifications"
                    android:tag="notifications"
                    />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_dark_mode"
                    android:tag="dark"
                    />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_manage_users"
                    android:tag="users"
                    />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_donations"
                    android:tag="donations"
                    />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_app_settings"
                    android:tag="appsettings"
                    />

                <!-- Section: Support -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Support"
                    android:textStyle="bold"
                    android:textColor="@color/textSecondary"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_help_center"
                    android:tag="help"
                    />

                <include layout="@layout/setting_row"
                    android:id="@+id/row_logout"
                    android:tag="logout"
                    />

            </LinearLayout>
        </ScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
