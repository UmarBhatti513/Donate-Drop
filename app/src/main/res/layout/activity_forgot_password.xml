<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <!-- 1) Top AppBar with red back arrow + title -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:titleMarginStart="100dp"
        app:title="Forgot Password"
        app:titleTextColor="@color/dd_red_700"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2) MaterialCardView in the center -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resetCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:background="@color/dd_gray_600"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"
        android:padding="24dp">

        <!-- 2.a) Use a vertical LinearLayout to center everything inside the card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@color/gray_light">

            <!-- 2.a.i) Red-tinted circle behind lock icon -->

            <!-- 2.a.ii) "Reset Your Password" heading -->

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_circle_red_alpha">

                <ImageView
                    android:id="@+id/icLock"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lock_white"
                    app:tint="@color/dd_white" />
            </FrameLayout>

            <TextView
                android:id="@+id/resetHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Your Password"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/dd_red_700"
                android:layout_marginTop="16dp" />

            <!-- 2.a.iii) Instruction text (centered) -->
            <TextView
                android:id="@+id/instructionText"
                android:layout_width="280dp"
                android:layout_height="60dp"
                android:layout_marginTop="2dp"
                android:text="Enter your email address and we’ll send you a link to reset your password."
                android:textSize="14sp"
                android:textColor="@color/dd_gray_600"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- 2.a.iv) Email input field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Address"

                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailEt"
                    android:layout_width="match_parent"
                    android:textColor="@color/black"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2.a.v) "Send Reset Link" button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendResetBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_gradient"
                android:backgroundTint="@color/dd_red_700"
                android:text="Send Reset Link"
                android:textAllCaps="false"
                android:textColor="@color/dd_white" />

            <!-- 2.a.vi) "Back to Login" link -->
            <TextView
                android:id="@+id/backToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Back to Login"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/dd_red_700" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3) Footer copyright (centered at bottom) -->
    <TextView
        android:id="@+id/footerCopyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2025 Donate Drop"
        android:textSize="12sp"
        android:textColor="@color/dd_gray_600"
        android:paddingBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
