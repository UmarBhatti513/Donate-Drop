<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:padding="1dp"
    android:background="@drawable/bg_notification_card"
    android:elevation="6dp"
    android:clipToPadding="false">

    <!-- Icon on left -->
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/colorPrimary" />

    <!-- Title text and optional badge/chip in a horizontal container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/titleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ivIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Notification Title"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="@color/TitleText"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chipBadge"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Badge/Chip for e.g. blood type A+ -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipBadge"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:text="A+"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:visibility="visible"
            app:chipBackgroundColor="@color/chipBackground"
            android:textColor="@color/colorOnPrimary"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="false"
            android:focusable="false"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Subtitle text (one or two lines) -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="Subtitle or description goes here."
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textSize="11sp"
        android:textColor="@color/SubtitleText"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/ivIcon"
        app:layout_constraintTop_toBottomOf="@id/titleContainer"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="0dp"/>

    <!-- Timestamp and priority in a smaller TextView -->
    <TextView
        android:id="@+id/tvTimestampPriority"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2 min ago · High Priority"
        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
        android:textColor="@color/SubtitleText"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@id/ivIcon"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"/>

    <!-- (star removed) -->
</androidx.constraintlayout.widget.ConstraintLayout>
