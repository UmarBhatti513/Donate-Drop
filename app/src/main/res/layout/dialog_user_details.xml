<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="@drawable/handle_bg"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialogIvAvatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/user"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dialogTvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#222"/>

            <TextView
                android:id="@+id/dialogTvRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textSize="12sp"
                android:layout_marginTop="0dp"
                android:textColor="#666"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0"/>

    <!-- Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="12sp"
            android:textColor="#888"/>
        <TextView
            android:id="@+id/dialogTvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="email@example.com"
            android:textSize="12sp"
            android:textColor="#333"
            android:layout_marginBottom="0dp"/>

        <!-- Add more user fields here as needed -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textSize="12sp"
            android:textColor="#888"/>
        <TextView
            android:id="@+id/dialogTvPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(not provided)"
            android:textSize="12sp"
            android:textColor="#333"
            android:layout_marginBottom="0dp"/>

        <!-- metadata / id -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User ID"
            android:textSize="12sp"
            android:textColor="#888"/>
        <TextView
            android:id="@+id/dialogTvId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="document-id"
            android:textSize="12sp"
            android:textColor="#333"
            android:layout_marginBottom="0dp"/>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="1dp">

        <Button
            android:id="@+id/btnClose"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:layout_marginStart="8dp"
            android:backgroundTint="#D65A5A"
            android:textColor="#fff" />
    </LinearLayout>

</LinearLayout>
