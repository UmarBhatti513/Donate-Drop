<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/detail_card_bg">

    <TextView
        android:id="@+id/tvReceiverName"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:text="Receiver: --"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvBloodType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Blood Type: --"
        android:textColor="@color/black"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity: --"
        android:textColor="@color/black"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvHospitalAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hospital: --"
        android:textColor="@color/black"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvCompletedBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Completed By: --"
        android:textColor="@color/black"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvCompletedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Completed At: --"
        android:textColor="@color/black"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: --"
        android:textColor="@android:color/holo_green_dark"
        android:textStyle="bold"/>

</LinearLayout>
