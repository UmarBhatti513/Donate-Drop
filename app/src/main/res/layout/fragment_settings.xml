<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top AppBar / Toolbar -->

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingTop="?attr/actionBarSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp"
                app:cardCornerRadius="8dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Avatar placeholder / real avatar -->
                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_profile_circle"
                        android:src="@drawable/ic_personn"
                        android:scaleType="centerInside"
                        android:contentDescription="@null"
                        android:layout_marginEnd="12dp" />

                    <!-- Name + View Profile -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/tv_profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextAppearance.MaterialComponents.Subtitle1"
                            android:textColor="@color/textPrimary"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_view_profile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextAppearance.MaterialComponents.Body2"
                            android:textColor="?attr/colorPrimary"
                            android:text="View Profile" />
                    </LinearLayout>

                    <!-- Arrow -->
                    <ImageView
                        android:id="@+id/iv_profile_arrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnBackground" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SETTINGS ITEMS LIST -->
            <!-- Notifications -->
            <include
                android:id="@+id/setting_notifications"
                layout="@layout/item_settings_notifications" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- Change Password -->
            <include
                android:id="@+id/setting_change_password"
                layout="@layout/item_settings_change_password" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- Language -->
            <include
                android:id="@+id/setting_language"
                layout="@layout/item_settings_language" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />


            <!-- About DonateDrop -->
            <include
                android:id="@+id/setting_about"
                layout="@layout/item_settings_about" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- Spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- Log Out button -->
            <Button
                android:id="@+id/btn_logout"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="?attr/colorPrimary"
                android:text="Log Out"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <!-- Delete Account button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_account"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="Delete Account"
                app:strokeColor="?attr/colorPrimary"
                android:textColor="?attr/colorPrimary"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorPrimary"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
