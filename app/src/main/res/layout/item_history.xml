<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:background="@color/cardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/cardBackground">

        <!-- Top row: Icon + Blood Type on left; Date/time on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/img_blood_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/blood_drop"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_blood_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A+"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <!-- spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan 01, 2024\n10:30 AM"
                android:textColor="@color/textSecondary"
                android:textSize="10sp"
                android:gravity="end" />
        </LinearLayout>

        <!-- Next row: location + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/img_location"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/location"
                app:tint="@color/textSecondary" />

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City Hospital, Karachi"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:layout_marginStart="6dp" />

            <!-- spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Status: dot + text -->
            <ImageView
                android:id="@+id/img_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/ic_dot_green"
                app:tint="@color/statusCompleted" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textColor="@color/statusCompleted"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
